{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zephyr-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // No public URL of its own. The landing Worker (and later the PWA Worker) forwards /api/* here
  // through a service binding, so the API is reachable only as
  // zephyr.midnightpoetry.studio/api/* and zephyrapp.midnightpoetry.studio/api/*.
  "workers_dev": false,
  "preview_urls": false,
  // Invocation logs record request metadata, including the client IP, for every request. Turn them
  // off so raw IPs never reach the log store; our own console.error lines carry no personal data.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "ratelimits": [
    {
      // Burst guard per client IP, counted per Cloudflare location. The durable limit
      // (5 per network per 15 minutes, 20 per day) is enforced in Postgres.
      "name": "BURST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Upload part and variant PUTs per member (keyed by user id): 240 a minute is ~3.75 GiB of
      // 16 MiB parts, far above a browser's real rate but a ceiling on abuse.
      "name": "UPLOAD_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 240, "period": 60 }
    }
  ],
  // Private photo bucket: no public access, no r2.dev URL. Every byte goes through this Worker.
  // Give it a lifecycle rule "abort incomplete multipart uploads after 1 day" (R2 › bucket › Settings ›
  // Object lifecycle rules), so multipart parts the clean-up job can't reach never linger.
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "zephyr-photos" }],
  // Library clean-up jobs (src/jobs.ts): expired uploads, Trash purges, account purges.
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "SUPABASE_URL": "https://YOUR-PROJECT-REF.supabase.co",
    // Publishable key (sb_publishable_…): not a secret, used as `apikey` on user-level Auth calls.
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_REPLACE_ME",
    // Landing-page forms (invite requests).
    "ALLOWED_ORIGINS": "https://zephyr.midnightpoetry.studio",
    // The app (sign-in, invites, account) and the admin console. Exact origins, no wildcards.
    "APP_ORIGINS": "https://zephyrapp.midnightpoetry.studio",
    "ADMIN_ORIGINS": "https://zephyr.midnightpoetry.studio",
    "APP_URL": "https://zephyrapp.midnightpoetry.studio",
    "TURNSTILE_EXPECTED_HOSTNAMES": "zephyr.midnightpoetry.studio,zephyrapp.midnightpoetry.studio",
    // Cloudflare Access application protecting zephyr.midnightpoetry.studio/admin*.
    "CF_ACCESS_TEAM_DOMAIN": "YOUR-TEAM.cloudflareaccess.com",
    "CF_ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
    "EMAIL_FROM": "Zephyr <hello@zephyr.midnightpoetry.studio>"
  }
  // Secrets (wrangler secret put …): SUPABASE_SECRET_KEY, TURNSTILE_SECRET_KEY, IP_HASH_SECRET,
  // SESSION_HMAC_SECRET, RESEND_API_KEY. (SUPABASE_SERVICE_ROLE_KEY is still read if the new name
  // isn't set.)
}
