{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zephyr-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // No public URL of its own. The landing Worker (and later the PWA Worker) forwards /api/* here
  // through a service binding, so the API is reachable only as
  // zephyr.midnightpoetry.studio/api/* and zephyrapp.midnightpoetry.studio/api/*.
  "workers_dev": false,
  "preview_urls": false,
  // Invocation logs record request metadata, including the client IP, for every request. Turn them
  // off so raw IPs never reach the log store; our own console.error lines carry no personal data.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "ratelimits": [
    {
      // Burst guard per client IP, counted per Cloudflare location. The durable limit
      // (5 per network per 15 minutes, 20 per day) is enforced in Postgres.
      "name": "BURST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Upload part and variant PUTs per member (keyed by user id): 240 a minute is ~3.75 GiB of
      // 16 MiB parts, far above a browser's real rate but a ceiling on abuse.
      "name": "UPLOAD_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 240, "period": 60 }
    },
    {
      // Edit writes per member (keyed by user id): saves, reverts, bulk paste/apply and recipe changes.
      // The editor autosaves about once a second while a slider moves; 600 a minute is ample headroom.
      // Edited-variant PUTs count against UPLOAD_LIMITER instead.
      "name": "EDIT_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      // Phase 5: sharing writes per member (keyed by user id): gallery changes, passcodes, renders,
      // branding, and reading a gallery's link again.
      "name": "SHARE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      // Guest page and API calls per network (token lookups, unlocks, favourites, reports). Durable
      // passcode limits are in Postgres (gallery_attempts).
      "name": "GUEST_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      // Guest image requests per network: a gallery page loads many thumbnails at once.
      "name": "MEDIA_LIMITER",
      "namespace_id": "1006",
      "simple": { "limit": 1200, "period": 60 }
    },
    {
      // Phase 6: Zephyr AI writes per member (keyed by user id): job creation, settings, device signals,
      // faces and people. Job creation also has its own per-minute limit in Admin › Zephyr AI.
      "name": "AI_LIMITER",
      "namespace_id": "1007",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      // Phase 6: face batches per member (keyed by user id). Each is up to 20 photos × 30 faces and is matched
      // against the member's people in Postgres, so this stays low.
      "name": "FACES_LIMITER",
      "namespace_id": "1008",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Phase 6: Zephyr AI reads per member (status, queue, people, scenes, cleanup pages, credit history).
      "name": "AI_READ_LIMITER",
      "namespace_id": "1009",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      // Phase 7: billing and team writes per member (keyed by user id): checkout, portal, plan changes,
      // team name, invites, roles, removals, leaving.
      "name": "BILLING_LIMITER",
      "namespace_id": "1010",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      // Phase 7: team invite emails per member (keyed by user id). Postgres also caps them at 20 an hour.
      "name": "TEAM_INVITE_LIMITER",
      "namespace_id": "1011",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      // Phase 8: admin portal writes per staff member (keyed by staff user id).
      "name": "ADMIN_LIMITER",
      "namespace_id": "1012",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      // Phase 8: member ad reads and impression/click events (keyed by user id).
      "name": "ADS_LIMITER",
      "namespace_id": "1013",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // Private photo bucket: no public access, no r2.dev URL. Every byte goes through this Worker.
  // Give it two lifecycle rules (R2 › bucket › Settings › Object lifecycle rules): "abort incomplete
  // multipart uploads after 1 day", so parts the clean-up job can't reach never linger, and "delete objects
  // with prefix staging/ after 2 days", which empties leftover staged variants (src/library/storage.ts).
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "zephyr-photos" },
    // Phase 5: guest renditions and branding assets (o/<ownerId>/…). No r2.dev URL. Its only public way in
    // is the custom domain MEDIA_HOST, behind a WAF rule that blocks requests without the X-Zephyr-Media
    // secret (docs/setup.md), so the Worker's fetches pass Cloudflare's cache and CSAM Scanning Tool.
    { "binding": "SHARED", "bucket_name": "zephyr-shared" }
  ],
  // Cloudflare Images (enable Images Paid before launch): every guest rendition and branding asset is
  // re-encoded with it.
  "images": { "binding": "IMAGES" },
  // Phase 6: Workers AI (scene tags), always through AI Gateway (AI_GATEWAY_ID) in production.
  "ai": { "binding": "AI" },
  // Phase 6: the zephyr-ai queue (src/ai/consumer.ts). Messages carry ids only. The consumer is this Worker.
  // Create both queues first: wrangler queues create zephyr-ai && wrangler queues create zephyr-ai-dlq
  // Phase 8: the zephyr-storage queue (src/storage/migrate.ts): each message is "copy the next 20 photos of
  // this migration" (ids only). wrangler queues create zephyr-storage && wrangler queues create zephyr-storage-dlq
  "queues": {
    "producers": [
      { "binding": "AI_QUEUE", "queue": "zephyr-ai" },
      { "binding": "STORAGE_QUEUE", "queue": "zephyr-storage" }
    ],
    "consumers": [
      {
        "queue": "zephyr-ai",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        // At most 4 batches (20 items) in flight: bounds the provider calls running at once, and with them
        // how far spend can run ahead of the reservations the caps check.
        "max_concurrency": 4,
        "max_retries": 3,
        "dead_letter_queue": "zephyr-ai-dlq"
      },
      {
        "queue": "zephyr-storage",
        // One message = one batch of 20 photos; two batches at once keeps the copy steady without
        // saturating a small on-premises uplink.
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_concurrency": 2,
        "max_retries": 5,
        "dead_letter_queue": "zephyr-storage-dlq"
      }
    ]
  },
  // Phase 8: on-premises stores reached over Workers VPC (beta) are service bindings, named in the store's
  // "binding" (docs/setup.md §3.8). Example:
  // "vpc_services": [{ "binding": "VPC_GARAGE", "service_id": "<from wrangler vpc service create>", "remote": true }],
  // Library clean-up jobs (src/jobs.ts): expired uploads, Trash purges, account purges; and Zephyr AI's
  // queue upkeep (src/ai/cron.ts): re-enqueue due items, scene-tag backfill, face-data plan lapses.
  // Phase 7: billing's daily job at 02:10 UTC (src/billing/cron.ts): price-change notices and moves.
  // Phase 8: storage every 5 minutes (src/storage/cron.ts): write-store health check (auto read-only after 3
  // failures), migration re-enqueue and old-copy deletion after the hold; admin daily jobs at 02:20.
  "triggers": { "crons": ["*/15 * * * *", "10 2 * * *", "20 2 * * *", "*/5 * * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "SUPABASE_URL": "https://YOUR-PROJECT-REF.supabase.co",
    // Publishable key (sb_publishable_…): not a secret, used as `apikey` on user-level Auth calls.
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_REPLACE_ME",
    // Landing-page forms (invite requests).
    "ALLOWED_ORIGINS": "https://zephyr.midnightpoetry.studio",
    // The app (sign-in, invites, account) and the admin console. Exact origins, no wildcards.
    "APP_ORIGINS": "https://zephyrapp.midnightpoetry.studio",
    "ADMIN_ORIGINS": "https://zephyr.midnightpoetry.studio",
    "APP_URL": "https://zephyrapp.midnightpoetry.studio",
    "TURNSTILE_EXPECTED_HOSTNAMES": "zephyr.midnightpoetry.studio,zephyrapp.midnightpoetry.studio",
    // Cloudflare Access application protecting zephyr.midnightpoetry.studio/admin*.
    "CF_ACCESS_TEAM_DOMAIN": "YOUR-TEAM.cloudflareaccess.com",
    "CF_ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
    "EMAIL_FROM": "Zephyr <hello@zephyr.midnightpoetry.studio>",
    // Phase 5: the zephyr-shared custom domain, and where safety alerts (CSAM matches and reports) go.
    "MEDIA_HOST": "media.midnightpoetry.studio",
    "SAFETY_ALERT_EMAIL": "safety@midnightpoetry.studio",
    // Phase 6: the AI Gateway every cloud AI call goes through (docs/setup.md §3.6).
    "AI_GATEWAY_ACCOUNT_ID": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
    "AI_GATEWAY_ID": "zephyr-prod"
    // Phase 7: STRIPE_API_VERSION may pin a Stripe API version; unset uses the installed SDK's own version.
    // Phase 8: STORAGE_STORES declares extra photo stores (docs/setup.md §3.8); 'r2' (PHOTOS) always exists.
    // No credentials here: endpoint, bucket, connection, declared cost and capacity only. Example:
    // "STORAGE_STORES": [
    //   { "id": "b2-eu", "name": "Backblaze B2 (EU)", "kind": "s3", "connection": "https",
    //     "endpoint": "https://s3.eu-central-003.backblazeb2.com", "bucket": "zephyr-photos-eu",
    //     "region": "eu-central-003", "costPerTbMonthUsd": 6, "egressNote": "Free up to 3× stored",
    //     "encryptionAtRest": true },
    //   { "id": "studio-nas", "name": "Studio NAS (Garage)", "kind": "s3", "connection": "vpc",
    //     "binding": "VPC_GARAGE", "endpoint": "http://garage.internal:3900", "bucket": "zephyr",
    //     "region": "garage", "pathStyle": true, "capacityBytes": 8000000000000,
    //     "costPerTbMonthUsd": null, "encryptionAtRest": true }
    // ]
  }
  // Secrets (wrangler secret put …): SUPABASE_SECRET_KEY, TURNSTILE_SECRET_KEY, IP_HASH_SECRET,
  // SESSION_HMAC_SECRET, RESEND_API_KEY, AD_DEDUP_SECRET (phase 8: the ad event dedup hash), ADS_COOKIE_SECRET (phase 8: signs the
  // AdSense cookie; the same value as the app Worker's). (SUPABASE_SERVICE_ROLE_KEY is still read if the new name
  // isn't set.)
  // Phase 5 secrets (each 32+ random bytes; GALLERY_LINK_KEY exactly 32 bytes, base64):
  //   GALLERY_PEPPER       keys passcode HMACs (changing it invalidates every passcode)
  //   GALLERY_LINK_KEY     AES-256-GCM key for gallery links at rest (changing it loses "copy link" for
  //                        existing galleries; the links themselves keep working)
  //   GUEST_COOKIE_SECRET  signs guests' unlock cookies (changing it re-locks every guest)
  //   MEDIA_URL_SECRET     signs guest media URLs (changing it breaks URLs for up to an hour)
  //   MEDIA_HOST_SECRET    the X-Zephyr-Media value the media host's WAF rule requires
  // Phase 6 secrets:
  //   RUNWARE_API_KEY      Runware (background removal)
  //   FAL_KEY              fal (background-removal fallback)
  //   AI_GATEWAY_TOKEN     the authenticated gateway's token (sent as cf-aig-authorization)
  // Phase 7 secrets (docs/phase-7.md, Build step 0):
  //   STRIPE_SECRET_KEY      restricted key (rk_…) with only the permissions listed in docs/phase-7.md
  //   STRIPE_WEBHOOK_SECRET  the webhook endpoint's signing secret (whsec_…), printed by scripts/stripe-setup.mjs
  // Phase 8 secrets, per store in STORAGE_STORES (<ID>: the id upper-cased, dashes → underscores):
  //   STORE_<ID>_ACCESS_KEY_ID, STORE_<ID>_SECRET         the store's S3 access key (least privilege: one bucket)
  //   STORE_<ID>_ACCESS_CLIENT_ID, STORE_<ID>_ACCESS_CLIENT_SECRET   tunnel stores: the Access service token
}
