# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
ENVIRONMENT=development
SUPABASE_URL=http://127.0.0.1:54321
ALLOWED_ORIGINS=http://localhost:4321
TURNSTILE_EXPECTED_HOSTNAMES=localhost
# From `supabase status` (local) or Project Settings › API keys (production). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# Turnstile test secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# 32+ random bytes, e.g. `openssl rand -base64 48`
IP_HASH_SECRET=
