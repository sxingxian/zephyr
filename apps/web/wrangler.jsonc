{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zephyr-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "zephyrapp.midnightpoetry.studio", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
    // Phase 8: the Worker runs first for every request so HTML pages get their CSP from it (the AdSense
    // variant only while AdSense is on). Static files are passed straight to ASSETS untouched; see worker/index.ts.
    "run_worker_first": true
  },
  "services": [{ "binding": "API", "service": "zephyr-api" }],
  // Secret (wrangler secret put ADS_COOKIE_SECRET): phase 8, the same value as the API Worker's. The Worker widens a
  // document's CSP for AdSense only when the request carries an AdSense cookie signed with it; without it, never.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
