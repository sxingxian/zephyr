{
  "name": "@zephyr/landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-brand.mjs && astro dev",
    "build": "node scripts/sync-brand.mjs && astro build && node scripts/copy-admin.mjs && node scripts/csp.mjs",
    "preview": "wrangler dev",
    "typecheck": "node scripts/sync-brand.mjs && astro check && tsc -p worker --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.0",
    "@fontsource-variable/geist-mono": "^5.2.0",
    "@zephyr/brand": "workspace:*",
    "@zephyr/shared": "workspace:*",
    "astro": "^7.4.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/three": "^0.186.0",
    "typescript": "7.0.2",
    "vitest": "^4.0.0",
    "wrangler": "^4.150.0",
    "@cloudflare/workers-types": "^5.20261020.0",
    "@zephyr/admin": "workspace:*"
  }
}
