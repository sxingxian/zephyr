---
import { viewAnim } from '../lib/motion';
import { kindAt } from '../lib/site';
import Icon from './Icon.astro';
import Sample from './Sample.astro';

const ratios = ['4 / 5', '4 / 3', '1 / 1', '3 / 4', '16 / 10'];
const tiles = Array.from({ length: 9 }, (_, i) => ({
  kind: kindAt(i + 6),
  ratio: ratios[i % 5],
  col: i % 3,
}));
---
<section class="section develop">
  <div class="wrap develop__inner">
    <div class="develop__head">
      <div class="section-head">
        <span class="chip chip--outline"><Icon name="layers" size={13} />Non-destructive</span>
        <h2 class="h2">Every edit is a recipe, not a rewrite.</h2>
      </div>
      <p class="lede">Copy a recipe to one photo or five hundred. Reset any of them back to the original, whenever you like.</p>
    </div>
    <div class="develop__masonry">
      {
        tiles.map((t) => (
          <figure class="develop__tile photo" style={`aspect-ratio: ${t.ratio}`} {...viewAnim('develop', { delay: t.col * 0.08 })}>
            <Sample kind={t.kind} />
          </figure>
        ))
      }
    </div>
  </div>
</section>
<style>
  .develop {
    padding-bottom: 40px;
  }
  .develop__inner {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }
  .develop__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
  }
  .develop__head .section-head {
    max-width: 680px;
    align-items: flex-start;
  }
  .develop__masonry {
    column-count: 3;
    column-width: 260px;
    column-gap: 18px;
  }
  .develop__tile {
    margin: 0 0 18px;
    break-inside: avoid;
    border-radius: 16px;
    box-shadow: 0 0 0 1px var(--line);
  }
</style>
